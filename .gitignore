# Only track Backend and claribi folders, ignore everything else at root
/*
!/Backend/
!/claribi/
!.gitignore


# Note: powerbi_docs is now included in deployment
# Backend/powerbi_docs/
# Backend/**/powerbi_docs/

# Backend specific ignores
Backend/__pycache__/
Backend/**/__pycache__/
Backend/*.py[cod]
Backend/**/*.py[cod]
Backend/*$py.class
Backend/**/*$py.class
Backend/.pytest_cache/
Backend/**/.pytest_cache/
Backend/.coverage
Backend/**/coverage
Backend/htmlcov/
Backend/**/htmlcov/
Backend/venv/
Backend/env/
Backend/ENV/
Backend/.env
Backend/**/.env
Backend/flask_session/
Backend/**/flask_session/
Backend/*.log
Backend/**/*.log
Backend/logs/
Backend/**/logs/
Backend/*.sqlite
Backend/*.sqlite3
Backend/*.db
Backend/**/*.sqlite
Backend/**/*.sqlite3
Backend/**/*.db
Backend/certificates/*.pem
Backend/certificates/*.key
Backend/certificates/*.crt
Backend/certificates/*.cer
Backend/certificates/*.der
Backend/**/certificates/*.pem
Backend/**/certificates/*.key
Backend/**/certificates/*.crt
Backend/**/certificates/*.cer
Backend/**/certificates/*.der
Backend/docs/_build/
Backend/**/docs/_build/
Backend/*.md
Backend/**/*.md
Backend/tests/

# claribi specific ignores
claribi/node_modules/
claribi/**/node_modules/
claribi/dist/
claribi/**/dist/
claribi/build/
claribi/**/build/
claribi/coverage/
claribi/**/coverage/
claribi/.env*.local
claribi/**/.env*.local
claribi/npm-debug.log*
claribi/yarn-debug.log*
claribi/yarn-error.log*
claribi/**/npm-debug.log*
claribi/**/yarn-debug.log*
claribi/**/yarn-error.log*
claribi/logs/
claribi/**/logs/
claribi/temp/
claribi/**/temp/
claribi/certificates/*.pem
claribi/certificates/*.key
claribi/certificates/*.crt
claribi/certificates/*.cer
claribi/certificates/*.der
claribi/**/certificates/*.pem
claribi/**/certificates/*.key
claribi/**/certificates/*.crt
claribi/**/certificates/*.cer
claribi/**/certificates/*.der
claribi/*.md
claribi/**/*.md
claribi/src/__tests__/
claribi/**/src/__tests__/
# IDE and editor files (global)
.idea/
.vscode/
*.swp
*.swo
.vs/
*.sublime-project
*.sublime-workspace

# OS generated files (global)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files (global)
*~
*.bak

# Railway deployment specific
.railway/
railway.json
railway.toml

# Environment files (keep .env.example)
.env
.env.local
.env.production
.env.staging

# Temporary files
*.tmp
*.temp