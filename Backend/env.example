# Production environment variables template
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-here-change-this
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Redis Configuration (if using Redis)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true

# Google AI Configuration
GOOGLE_API_KEY=your-google-api-key

# Microsoft Authentication
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_REDIRECT_URI=https://your-domain.com/api/auth/callback

# Frontend Configuration
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.com

# Security Configuration
SECURE_COOKIES=true
COOKIE_SAMESITE=Strict
ENABLE_HSTS=true

# Token Encryption
TOKEN_ENCRYPTION_KEY=your-token-encryption-key
TOKEN_ENCRYPTION_ALGORITHM=fernet

# RAG Pipeline Configuration
VECTOR_EMBEDDING_MODEL=text-embedding-004
RAG_LLM_MODEL=gemini-2.5-flash
VECTOR_STORE_COLLECTION_PREFIX=pbix_
MAX_RETRIEVAL_DOCS=5
ENABLE_ITERATIVE_RAG=true
MAX_RAG_ITERATIONS=4
MAX_FOLLOW_UP_QUERIES_PER_ITERATION=3
RAG_CONTEXT_ANALYSIS_THRESHOLD=0.7

# Rate Limiting
AUTH2_RATE_LIMIT_LOGIN=5 per minute
AUTH2_RATE_LIMIT_CALLBACK=10 per minute

# File Upload Limits
MAX_CONTENT_LENGTH=16777216
